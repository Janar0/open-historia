# Local-only is the safe default. Use 0.0.0.0 only for a LAN/Tailscale server.
OH_HOST=0.0.0.0
PORT=3000

# Recommended: keep the shared key in a file readable only by the server user.
# Generate one with: openssl rand -hex 32 > open-historia-server.key
OH_SHARED_API_KEY_FILE=/absolute/path/open-historia-server.key

# Optional per-user accounts. Docker enables this by default; the first
# registered account becomes admin and can add the other players.
# OH_USER_AUTH=1
# OH_REGISTRATION_OPEN=1
# OH_SECURE_COOKIES=1   # use behind HTTPS

# Alternatively, set the value directly (do not commit a real key).
# OH_SHARED_API_KEY=replace-with-a-long-random-key
