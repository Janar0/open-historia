# Local-only is the safe default. Use 0.0.0.0 only for a LAN/Tailscale server.
OH_HOST=0.0.0.0
PORT=3000

# Recommended: keep the shared key in a file readable only by the server user.
# Generate one with: openssl rand -hex 32 > open-historia-server.key
OH_SHARED_API_KEY_FILE=/absolute/path/open-historia-server.key

# Optional per-user accounts. Docker enables this by default; the first
# registered account becomes admin and can add the other players.
# OH_USER_AUTH=1
# OH_REGISTRATION_OPEN=1
# OH_SECURE_COOKIES=1   # use behind HTTPS

# Alternatively, set the value directly (do not commit a real key).
# OH_SHARED_API_KEY=replace-with-a-long-random-key

# A domain this server is opened by (behind a reverse proxy). IP addresses and
# localhost always work; other names are refused unless listed here.
# OH_ALLOWED_HOSTS=historia.example.com

# Refuse to start without a shared key. The Docker image sets this.
# OH_REQUIRE_AUTH=1

# Optional server-side AI profile for every player: an OpenAI-compatible
# endpoint, model and key. The key never reaches a browser; the server's relay
# adds it. An admin can also set this in the game: Account → AI for players.
# OH_AI_ENDPOINT=https://openrouter.ai/api/v1
# OH_AI_MODEL=
# OH_AI_API_KEY=

# Behind a reverse proxy all players share one address, and so one allowance
# of requests a minute (default 1200). Raise it there.
# OH_RATE_LIMIT=20000
